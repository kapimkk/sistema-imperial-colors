<Window x:Class="ImperialColors.UI.Views.ProdutoFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:ImperialColors.UI.Helpers"
        Title="Produto" Width="720" Height="740"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ImperialColors;component/Resources/AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="ComboBoxNomeTemplate">
                <TextBlock Text="{Binding Nome}" FontSize="13"/>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource CinzaClaroBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="25,18">
            <StackPanel>
                <TextBlock x:Name="TxtTitulo" Text="Novo Produto"
                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource PretoPrimarioBrush}"/>
                <TextBlock Text="Cadastro comercial — estoque, preços e fornecedor"
                           FontSize="12" Foreground="{StaticResource CinzaTextoBrush}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="20,12,20,8" VerticalScrollBarVisibility="Auto"
                      helpers:ScrollViewerMouseWheelHelper.Habilitar="True">
            <StackPanel>
                <TextBlock Text="DADOS DO PRODUTO" FontWeight="Bold" Margin="0,0,0,12"/>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource LabelCampo}" Text="Nome do Produto *"/>
                    <TextBox x:Name="TxtNome" Style="{StaticResource TextBoxModerno}"
                             LostFocus="TxtNome_LostFocus"/>
                </StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource LabelCampo}" Text="Código do Produto *"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtCodigoInterno" Grid.Column="0"
                                     Style="{StaticResource TextBoxModerno}"
                                     IsReadOnly="True"
                                     TextChanged="TxtCodigoInterno_TextChanged"/>
                            <Button x:Name="BtnAlternarCodigoManual" Grid.Column="2"
                                    Content="🔒" ToolTip="Desbloquear edição manual do código"
                                    Style="{StaticResource BotaoSecundario}" Padding="0" Height="38"
                                    Click="BtnAlternarCodigoManual_Click"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource LabelCampo}" Text="Código de Barras"/>
                        <TextBox x:Name="TxtCodigoBarras" Style="{StaticResource TextBoxModerno}"
                                 LostFocus="TxtCodigoBarras_LostFocus"
                                 ToolTip="Use um leitor de código de barras ou digite manualmente"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource LabelCampo}" Text="Fornecedor (opcional)"/>
                        <ComboBox x:Name="CmbFornecedor" Style="{StaticResource ComboBoxModerno}"
                                  SelectedValuePath="Id"
                                  ItemTemplate="{StaticResource ComboBoxNomeTemplate}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource LabelCampo}" Text="Data de Validade (opcional)"/>
                        <DatePicker x:Name="DpValidade" Style="{StaticResource DatePickerModerno}"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="TxtErroValidacao" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource VermelhoErroBrush}" Visibility="Collapsed"
                           Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource LabelCampo}" Text="Categoria *"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbCategoria" Grid.Column="0"
                                      Style="{StaticResource ComboBoxModerno}"
                                      SelectedValuePath="Id"
                                      ItemTemplate="{StaticResource ComboBoxNomeTemplate}"
                                      SelectionChanged="CmbCategoria_SelectionChanged"/>
                            <Button Grid.Column="2" Content="+" ToolTip="Cadastrar nova categoria"
                                    Style="{StaticResource BotaoPrimario}" FontSize="16" FontWeight="Bold"
                                    Padding="0" Height="36" Click="BtnNovaCategoria_Click"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource LabelCampo}" Text="Marca *"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbMarca" Grid.Column="0"
                                      Style="{StaticResource ComboBoxModerno}"
                                      SelectedValuePath="Id"
                                      ItemTemplate="{StaticResource ComboBoxNomeTemplate}"/>
                            <Button Grid.Column="2" Content="+" ToolTip="Cadastrar nova marca"
                                    Style="{StaticResource BotaoPrimario}" FontSize="16" FontWeight="Bold"
                                    Padding="0" Height="36" Click="BtnNovaMarca_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource LabelCampo}" Text="Quantidade em Estoque"/>
                        <TextBox x:Name="TxtQuantidade" Style="{StaticResource TextBoxNumerico}" Text="0"
                                 TextChanged="TxtQuantidade_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource LabelCampo}" Text="Estoque Mínimo"/>
                        <TextBox x:Name="TxtEstoqueMinimo" Style="{StaticResource TextBoxNumerico}" Text="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource LabelCampo}" Text="Unidade"/>
                        <ComboBox x:Name="CmbUnidade" Style="{StaticResource ComboBoxModerno}">
                            <ComboBoxItem Content="UN"/>
                            <ComboBoxItem Content="GL"/>
                            <ComboBoxItem Content="BD"/>
                            <ComboBoxItem Content="BA"/>
                            <ComboBoxItem Content="LA"/>
                            <ComboBoxItem Content="LT"/>
                            <ComboBoxItem Content="RL"/>
                            <ComboBoxItem Content="CX"/>
                            <ComboBoxItem Content="PCT"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource LabelCampo}" Text="Tamanho da Embalagem"/>
                        <TextBox x:Name="TxtTamanhoEmbalagem" Style="{StaticResource TextBoxModerno}" MaxLength="30"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,6"
                               FontSize="12" Foreground="{StaticResource CinzaTextoBrush}"
                               Text="Opcional, texto livre — ex.: 18L, 3,6L, 25 KG. Aparece junto ao nome do produto nas telas de venda."
                               TextWrapping="Wrap"/>
                </Grid>

                <StackPanel Margin="0,0,0,12">
                    <CheckBox x:Name="ChkCustoTotal"
                              Content="Informar Valor Total da Compra"
                              FontSize="12" Margin="0,0,0,10"
                              Checked="ChkCustoTotal_Changed"
                              Unchecked="ChkCustoTotal_Changed"/>
                    <Grid x:Name="PainelCustoTotal" Visibility="Collapsed" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource LabelCampo}" Text="Valor Total da Compra (R$)"/>
                            <TextBox x:Name="TxtCustoTotal" Style="{StaticResource TextBoxNumerico}"
                                     TextChanged="TxtCustoTotal_TextChanged"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource LabelCampo}" Text="Custo Unitário (R$)"/>
                            <TextBox x:Name="TxtCusto" Style="{StaticResource TextBoxNumerico}"
                                     TextChanged="TxtCusto_TextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource LabelCampo}" Text="Preço de Venda (R$) *"/>
                            <TextBox x:Name="TxtPrecoVenda" Style="{StaticResource TextBoxNumerico}" Text="R$ 0,00"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="ChkPromocaoAtiva"
                                  Content="Modo Promocional / Preço de Desconto"
                                  FontWeight="SemiBold"
                                  Checked="ChkPromocaoAtiva_Changed"
                                  Unchecked="ChkPromocaoAtiva_Changed"/>
                        <StackPanel x:Name="PainelPrecoPromocional" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource LabelCampo}" Text="Preço Promocional (R$) *"/>
                            <TextBox x:Name="TxtPrecoPromocional" Style="{StaticResource TextBoxNumerico}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="DESCRIÇÃO" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource LabelCampo}" Text="Descrição / Observações"/>
                        <TextBox x:Name="TxtObservacoes" Style="{StaticResource TextBoxModerno}"
                                 Height="90" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="10000"
                                 VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="Texto enviado ao site. As quebras de linha são preservadas; não use HTML."
                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource CinzaTextoBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="FRETE / DIMENSÕES" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtFretePendente" Text="Dados de frete pendentes" TextWrapping="Wrap"
                                   Foreground="{StaticResource VermelhoErroBrush}" Margin="0,0,0,10"/>
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Peso (kg)"/>
                                <TextBox x:Name="TxtPesoKg" Style="{StaticResource TextBoxNumerico}" MaxLength="16"
                                         TextChanged="TxtFrete_TextChanged"/>
                                <TextBlock x:Name="TxtPesoEquivalente" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Altura (cm)"/>
                                <TextBox x:Name="TxtAlturaCm" Style="{StaticResource TextBoxNumerico}" MaxLength="12"
                                         TextChanged="TxtFrete_TextChanged"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Largura (cm)"/>
                                <TextBox x:Name="TxtLarguraCm" Style="{StaticResource TextBoxNumerico}" MaxLength="12"
                                         TextChanged="TxtFrete_TextChanged"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Comprimento (cm)"/>
                                <TextBox x:Name="TxtComprimentoCm" Style="{StaticResource TextBoxNumerico}" MaxLength="12"
                                         TextChanged="TxtFrete_TextChanged"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock x:Name="TxtRegraFrete" Text="Obrigatórios para novos produtos. Peso com até 3 casas decimais; dimensões com até 2."
                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource CinzaTextoBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="IMAGEM DO PRODUTO" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="{StaticResource CinzaClaroBrush}" Padding="6" CornerRadius="6">
                                <Image x:Name="ImgProduto" Height="115" Width="115" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtImagemEstado" Text="Produto sem imagem" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button x:Name="BtnSelecionarImagem" Content="Selecionar imagem" Style="{StaticResource BotaoSecundario}"
                                            Click="BtnSelecionarImagem_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnRemoverImagem" Content="Remover imagem" Style="{StaticResource BotaoSecundario}"
                                            Click="BtnRemoverImagem_Click" IsEnabled="False"/>
                                </WrapPanel>
                                <TextBlock Text="JPEG ou PNG, até 5 MB. A imagem principal será enviada ao site."
                                           FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource CinzaTextoBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Expander x:Name="ExpTributacao"
                          Header="Tributação (NCM, ICMS, PIS/COFINS, IPI) — opcional"
                          FontWeight="SemiBold" IsExpanded="False">
                    <Border Style="{StaticResource Card}" Padding="15" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource CinzaTextoBrush}"
                                           Text="Usado para emissão futura de NF-e/NFC-e. Ainda é opcional salvar o produto sem preencher — mas os campos com * são obrigatórios por lei em toda nota fiscal assim que a emissão for ativada; os sem * só se aplicam em situações específicas (ex.: Substituição Tributária)."/>
                                <Button x:Name="BtnSalvarPadraoCategoria" Grid.Column="2"
                                        Content="💾 Definir como padrão da categoria"
                                        Style="{StaticResource BotaoSecundario}" FontSize="11"
                                        Padding="8,4" VerticalAlignment="Top"
                                        ToolTip="Salva os campos fiscais preenchidos acima como padrão para novos produtos desta categoria"
                                        Click="BtnSalvarPadraoCategoria_Click"/>
                            </Grid>

                            <TextBlock x:Name="TxtOrigemPadraoCategoria" FontSize="11" FontStyle="Italic"
                                       Foreground="{StaticResource AmareloPrimarioBrush}" Margin="0,0,0,6"
                                       Visibility="Collapsed"
                                       Text="Campos preenchidos automaticamente com o padrão fiscal da categoria — revise e ajuste se necessário."/>

                            <TextBlock x:Name="TxtRegimeInfo" FontSize="11" FontStyle="Italic"
                                       Foreground="{StaticResource CinzaTextoBrush}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="NCM *"
                                               ToolTip="Obrigatório em toda NF-e/NFC-e, sem exceção. Digite o código ou uma palavra-chave (ex.: 'tinta') para ver sugestões da Tabela NCM oficial."/>
                                    <TextBox x:Name="TxtNcm" Style="{StaticResource TextBoxModerno}"
                                             TextChanged="TxtNcm_TextChanged"/>
                                    <Popup x:Name="PopupSugestoesNcm" PlacementTarget="{Binding ElementName=TxtNcm}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="380">
                                        <Border Background="White" BorderBrush="{StaticResource CinzaMedioBrush}"
                                                BorderThickness="1" CornerRadius="4">
                                            <Border.Effect>
                                                <DropShadowEffect ShadowDepth="1" BlurRadius="8" Opacity="0.15" Color="#000000"/>
                                            </Border.Effect>
                                            <ListBox x:Name="LstSugestoesNcm" MaxHeight="220" BorderThickness="0"
                                                     SelectionChanged="LstSugestoesNcm_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="10,6">
                                                            <TextBlock Text="{Binding Codigo}" FontWeight="SemiBold" FontSize="12"/>
                                                            <TextBlock Text="{Binding Descricao}" FontSize="11" TextWrapping="Wrap"
                                                                       Foreground="{StaticResource CinzaTextoBrush}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="CEST"
                                               ToolTip="Obrigatório apenas se o produto estiver sujeito a Substituição Tributária (ICMS-ST) ou listado nos convênios do CEST — confirme com o contador."/>
                                    <TextBox x:Name="TxtCest" Style="{StaticResource TextBoxModerno}" MaxLength="7"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="Origem da Mercadoria *"
                                               ToolTip="Obrigatório em toda NF-e/NFC-e, sem exceção."/>
                                    <ComboBox x:Name="CmbOrigem" Style="{StaticResource ComboBoxModerno}">
                                        <ComboBoxItem Content="0 - Nacional" Tag="0"/>
                                        <ComboBoxItem Content="1 - Estrangeira, importação direta" Tag="1"/>
                                        <ComboBoxItem Content="2 - Estrangeira, mercado interno" Tag="2"/>
                                        <ComboBoxItem Content="3 - Nacional, importação superior a 40%" Tag="3"/>
                                        <ComboBoxItem Content="4 - Nacional, processo produtivo básico" Tag="4"/>
                                        <ComboBoxItem Content="5 - Nacional, importação até 40%" Tag="5"/>
                                        <ComboBoxItem Content="6 - Estrangeira, importação direta, sem similar" Tag="6"/>
                                        <ComboBoxItem Content="7 - Estrangeira, mercado interno, sem similar" Tag="7"/>
                                        <ComboBoxItem Content="8 - Nacional, importação superior a 70%" Tag="8"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="CFOP Venda Dentro do Estado *"
                                               ToolTip="Obrigatório em toda NF-e/NFC-e. Sempre começa com 5 (ex.: 5102 = venda de mercadoria adquirida de terceiros)."/>
                                    <TextBox x:Name="TxtCfopDentroEstado" Style="{StaticResource TextBoxModerno}" MaxLength="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="CFOP Venda Fora do Estado *"
                                               ToolTip="Obrigatório em toda NF-e/NFC-e. Sempre começa com 6 (ex.: 6102 = venda de mercadoria adquirida de terceiros)."/>
                                    <TextBox x:Name="TxtCfopForaEstado" Style="{StaticResource TextBoxModerno}" MaxLength="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                               Foreground="{StaticResource CinzaTextoBrush}"
                                               Text="A venda decide qual dos dois usar, comparando a UF da loja com a UF do comprador — não é uma escolha manual por venda."/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel x:Name="PainelCstIcms">
                                        <TextBlock Style="{StaticResource LabelCampo}" Text="CST ICMS *"
                                                   ToolTip="Obrigatório — define a situação tributária do ICMS para este item."/>
                                        <TextBox x:Name="TxtCstIcms" Style="{StaticResource TextBoxModerno}" MaxLength="2"/>
                                    </StackPanel>
                                    <StackPanel x:Name="PainelCsosnIcms">
                                        <TextBlock Style="{StaticResource LabelCampo}" Text="CSOSN ICMS *"
                                                   ToolTip="Obrigatório — define a situação tributária do ICMS para este item (Simples Nacional)."/>
                                        <TextBox x:Name="TxtCsosnIcms" Style="{StaticResource TextBoxModerno}" MaxLength="3"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="Alíquota ICMS (%)"
                                               ToolTip="Obrigatória quando o CST/CSOSN indicar tributação normal do ICMS; não se aplica a códigos de isenção/não-tributado/substituição exclusiva."/>
                                    <TextBox x:Name="TxtAliquotaIcms" Style="{StaticResource TextBoxNumerico}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="Alíquota ICMS-ST (%)"
                                               ToolTip="Obrigatória apenas em operações com Substituição Tributária."/>
                                    <TextBox x:Name="TxtAliquotaIcmsSt" Style="{StaticResource TextBoxNumerico}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="MVA / IVA-ST (%)"
                                               ToolTip="Obrigatória apenas em operações com Substituição Tributária."/>
                                    <TextBox x:Name="TxtMva" Style="{StaticResource TextBoxNumerico}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="Redução Base de Cálculo (%)"
                                               ToolTip="Só quando houver benefício fiscal de redução de base de cálculo."/>
                                    <TextBox x:Name="TxtReducaoBaseCalculo" Style="{StaticResource TextBoxNumerico}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="Alíquota ICMS-ST Retido — pST (%)"
                                               ToolTip="Só para CST 60 / CSOSN 500 (ICMS-ST já cobrado por um elo anterior da cadeia — fabricante/distribuidor). Percentual informado na nota de compra ou em tabela do fisco estadual, não calculado por fórmula."/>
                                    <TextBox x:Name="TxtAliquotaIcmsStRetido" Style="{StaticResource TextBoxNumerico}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="CST PIS *"
                                               ToolTip="Obrigatório em toda NF-e/NFC-e, sem exceção."/>
                                    <TextBox x:Name="TxtCstPis" Style="{StaticResource TextBoxModerno}" MaxLength="2"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="Alíquota PIS (%)"
                                               ToolTip="Obrigatória quando o CST indicar tributação normal do PIS; não se aplica a isenção/suspensão/alíquota zero."/>
                                    <TextBox x:Name="TxtAliquotaPis" Style="{StaticResource TextBoxNumerico}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="CST COFINS *"
                                               ToolTip="Obrigatório em toda NF-e/NFC-e, sem exceção."/>
                                    <TextBox x:Name="TxtCstCofins" Style="{StaticResource TextBoxModerno}" MaxLength="2"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="Alíquota COFINS (%)"
                                               ToolTip="Obrigatória quando o CST indicar tributação normal do COFINS; não se aplica a isenção/suspensão/alíquota zero."/>
                                    <TextBox x:Name="TxtAliquotaCofins" Style="{StaticResource TextBoxNumerico}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="CST IPI"
                                               ToolTip="Só se aplica a indústria/equiparado a industrial/importador. Comércio varejista puro geralmente NÃO recolhe IPI — confirme com o contador antes de preencher."/>
                                    <TextBox x:Name="TxtCstIpi" Style="{StaticResource TextBoxModerno}" MaxLength="2"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="Cód. Enquadramento IPI"
                                               ToolTip="Só se aplica quando a loja é contribuinte de IPI."/>
                                    <TextBox x:Name="TxtCodigoEnquadramentoIpi" Style="{StaticResource TextBoxModerno}" MaxLength="3"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="Alíquota IPI (%)"
                                               ToolTip="Só se aplica quando a loja é contribuinte de IPI."/>
                                    <TextBox x:Name="TxtAliquotaIpi" Style="{StaticResource TextBoxNumerico}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="Valor Fixo do IPI (R$)"
                                               ToolTip="Só para produtos com tributação de IPI por valor fixo em vez de percentual — raro, deixe em branco se usar Alíquota IPI."/>
                                    <TextBox x:Name="TxtValorIpiFixo" Style="{StaticResource TextBoxNumerico}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="EX TIPI"
                                               ToolTip="Código de exceção da Tabela de Incidência do IPI para este NCM, quando aplicável."/>
                                    <TextBox x:Name="TxtExTipi" Style="{StaticResource TextBoxModerno}" MaxLength="3"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="Unidade Tributável"/>
                                    <TextBox x:Name="TxtUnidadeTributavel" Style="{StaticResource TextBoxModerno}" MaxLength="10"
                                             ToolTip="Deixe em branco para usar a mesma unidade comercial do produto"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="Fator de Conversão"/>
                                    <TextBox x:Name="TxtFatorConversao" Style="{StaticResource TextBoxNumerico}"
                                             ToolTip="Ex.: 1 unidade comercial = X unidades tributáveis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="GTIN Tributável"/>
                                    <TextBox x:Name="TxtGtinTributavel" Style="{StaticResource TextBoxModerno}" MaxLength="14"
                                             ToolTip="A tag é obrigatória na NF-e, mas se o produto não tem código de barras o sistema usa 'SEM GTIN' automaticamente — não precisa preencher."/>
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,16,0,0" Padding="0,12,0,0"
                                    BorderBrush="{StaticResource CinzaMedioBrush}" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <TextBlock Text="Reforma Tributária — IBS/CBS (LC 214/2025)" FontSize="12"
                                               FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"
                                               Foreground="{StaticResource CinzaTextoBrush}"
                                               Text="Preparação para a nova tributação nacional que substitui ICMS/ISS/PIS/COFINS — sem alíquota manual (é calculada automaticamente pelo emissor a partir do cClassTrib quando a emissão de NF-e/NFC-e for implementada). CST + cClassTrib se tornam obrigatórios (*) no cronograma oficial: 03/08/2026 para Lucro Presumido/Real, 01/2027 para Simples Nacional. Consulte a tabela oficial no Portal Nacional da NFC-e antes de preencher."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="1.4*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource LabelCampo}" Text="CST IBS/CBS *"
                                                       ToolTip="Obrigatório a partir do prazo legal do regime da empresa (ver Configurações → Fiscal)."/>
                                            <TextBox x:Name="TxtCstIbsCbs" Style="{StaticResource TextBoxModerno}" MaxLength="3"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource LabelCampo}" Text="cClassTrib IBS/CBS *"
                                                       ToolTip="6 dígitos — os 3 primeiros repetem o CST IBS/CBS. Obrigatório junto com o CST."/>
                                            <TextBox x:Name="TxtCClassTrib" Style="{StaticResource TextBoxModerno}" MaxLength="6"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource LabelCampo}" Text="CST Imposto Seletivo"/>
                                            <TextBox x:Name="TxtCstIS" Style="{StaticResource TextBoxModerno}" MaxLength="3"
                                                     ToolTip="Normalmente vazio — só se aplica a itens do Imposto Seletivo"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Style="{StaticResource LabelCampo}" Text="cClassTrib IS"/>
                                            <TextBox x:Name="TxtCClassTribIS" Style="{StaticResource TextBoxModerno}" MaxLength="6"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,12,0,8"
                                               Foreground="{StaticResource CinzaTextoBrush}"
                                               Text="Exceções à Regra Geral da empresa (Configurações → Fiscal) — só preencha se ESTE produto tem tratamento diferente do padrão."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource LabelCampo}" Text="Diferimento IBS Municipal (%)"/>
                                            <TextBox x:Name="TxtAliquotaIbsMunicipioDiferimento" Style="{StaticResource TextBoxNumerico}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource LabelCampo}" Text="Redução IBS Municipal (%)"/>
                                            <TextBox x:Name="TxtAliquotaIbsMunicipioReducao" Style="{StaticResource TextBoxNumerico}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource LabelCampo}" Text="Alíquota do IS (%)"/>
                                            <TextBox x:Name="TxtAliquotaIS" Style="{StaticResource TextBoxNumerico}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                        Margin="0,0,10,0" Click="BtnCancelar_Click"/>
                <Button x:Name="BtnSalvar" Content="Salvar Produto" Style="{StaticResource BotaoPrimario}"
                        Click="BtnSalvar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
