<UserControl x:Class="ImperialColors.UI.Views.EstoqueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ImperialColors.UI.Converters"
             xmlns:helpers="clr-namespace:ImperialColors.UI.Helpers">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ImperialColors;component/Resources/AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:MoedaConverter x:Key="MoedaConverter"/>
            <conv:QuantidadeConverter x:Key="QuantidadeConverter"/>
            <conv:UnidadeMedidaConverter x:Key="UnidadeMedidaConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:InvertBoolToVisibilityConverter x:Key="InvertBoolToVisibility"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Style="{StaticResource TituloModulo}" Text="Controle de Estoque"/>
                <TextBlock x:Name="TxtResumoTotal" Foreground="{StaticResource CinzaTextoBrush}" FontSize="13" Margin="0,4,0,0"
                           Text="{Binding ResumoTotalProdutos}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource BotaoSecundario}" Command="{Binding MovimentacaoCommand}"
                        Margin="0,0,10,0" Content="↕  Movimentação"/>
                <Button Style="{StaticResource BotaoPrimario}" Command="{Binding NovoProdutoCommand}"
                        Content="+ Novo Produto"/>
            </StackPanel>
        </Grid>

        <!-- Barra de busca e filtros -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBox x:Name="TxtBuscaEstoque" Style="{StaticResource TextBoxFiltro}"
                             helpers:PlaceholderHelper.Text="Buscar por nome, código ou código de barras..."
                             Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="TxtBuscaEstoque_KeyDown"/>
                    <TextBlock x:Name="TxtAvisoBarrasEstoque" Margin="4,4,0,0" FontSize="12"
                               Foreground="{StaticResource VermelhoErroBrush}" Visibility="Collapsed"/>
                    <!-- Leitura de código de barras que achou um produto de unidade fora do filtro. -->
                    <TextBlock x:Name="TxtAvisoFiltroUnidade" Margin="4,4,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource VermelhoErroBrush}"
                               Text="{Binding AvisoFiltroUnidade}"
                               Visibility="{Binding TemAvisoFiltroUnidade, Converter={StaticResource BoolToVisibility}}"/>
                    <CheckBox Margin="0,10,0,0" Content="Apenas em Promoção"
                              IsChecked="{Binding ApenasEmPromocao, UpdateSourceTrigger=PropertyChanged}"
                              FontSize="13" FontWeight="SemiBold"
                              Foreground="{StaticResource PretoPrimarioBrush}"/>
                </StackPanel>

                <!-- Filtro por unidade de medida: persistente, só sai em "Limpar filtro". -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                    <ToggleButton x:Name="BtnFiltroUnidade" Style="{StaticResource TogglePagamento}"
                                  ToolTip="Mostrar só produtos de certas unidades de medida (BD, GL, LA...). O filtro fica ligado até você clicar em Limpar filtro."
                                  IsChecked="{Binding FiltroUnidadeAberto, Mode=TwoWay}"
                                  IsHitTestVisible="{Binding ElementName=PopupFiltroUnidade, Path=IsOpen, Converter={StaticResource InverseBool}}">
                        <TextBlock>
                            <Run Text="⏷  "/><Run Text="{Binding TextoFiltroUnidade, Mode=OneWay}"/>
                        </TextBlock>
                    </ToggleButton>
                    <Button x:Name="BtnLimparFiltroUnidade" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0"
                            Command="{Binding LimparFiltroUnidadeCommand}" Content="✕  Limpar filtro"
                            Visibility="{Binding FiltroUnidadeAtivo, Converter={StaticResource BoolToVisibility}}"/>

                    <Popup x:Name="PopupFiltroUnidade" PlacementTarget="{Binding ElementName=BtnFiltroUnidade}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           IsOpen="{Binding FiltroUnidadeAberto, Mode=TwoWay}">
                        <Border Background="White" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="8"
                                Padding="14,12" Margin="0,6,8,8" MinWidth="190">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Unidade de medida" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2"/>
                                <TextBlock Text="Marque uma ou mais" FontSize="11" Margin="0,0,0,8"
                                           Foreground="{StaticResource CinzaTextoBrush}"/>
                                <ItemsControl x:Name="ListaUnidades" ItemsSource="{Binding OpcoesUnidade}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Sigla}" IsChecked="{Binding Selecionada, Mode=TwoWay}"
                                                      FontSize="13" Margin="0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource BotaoSecundario}" Margin="10,0,0,0"
                        Command="{Binding AtualizarCommand}" Content="⟳  Atualizar"/>
                <Button Grid.Column="3" Style="{StaticResource BotaoSecundario}" Margin="10,0,0,0"
                        Command="{Binding EditarProdutoCommand}" Content="✏  Editar"/>
                <Button Grid.Column="4" Style="{StaticResource BotaoPerigo}" Margin="10,0,0,0"
                        Command="{Binding ExcluirProdutoCommand}" Content="🗑  Excluir"/>
            </Grid>
        </Border>

        <!-- DataGrid de produtos -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid Style="{StaticResource DataGridModerno}"
                              ItemsSource="{Binding Produtos}"
                              SelectedItem="{Binding ProdutoSelecionado}"
                              ColumnHeaderStyle="{StaticResource DataGridHeaderModerno}"
                              IsEnabled="{Binding Carregando, Converter={StaticResource InverseBool}}"
                              IsReadOnly="True" MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding CodigoInterno}" Width="100"/>
                    <DataGridTextColumn Header="Cód. Barras" Binding="{Binding CodigoBarras}" Width="120"/>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                    <DataGridTextColumn Header="Categoria" Binding="{Binding CategoriaNome}" Width="120"/>
                    <DataGridTextColumn Header="Marca" Binding="{Binding MarcaNome}" Width="100"/>
                    <!-- Quantidade e unidade em colunas separadas: a quantidade lê e ordena como número
                         (SortMemberPath no valor, não no texto formatado) e a unidade filtra o olho
                         para "o que está em litros / galões". As cores de estoque baixo e zerado
                         ficam na quantidade, onde o olho procura. -->
                    <DataGridTextColumn Header="Quantidade" Width="110"
                                        Binding="{Binding QuantidadeEstoque, Converter={StaticResource QuantidadeConverter}}"
                                        SortMemberPath="QuantidadeEstoque">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,12,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SemEstoque}" Value="True">
                                        <Setter Property="Foreground" Value="#DC3545"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EstoqueBaixo}" Value="True">
                                        <Setter Property="Foreground" Value="#FD7E14"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Unidade" Width="80"
                                        Binding="{Binding Unidade, Converter={StaticResource UnidadeMedidaConverter}}"
                                        SortMemberPath="Unidade"/>
                    <DataGridTextColumn Header="Custo"
                                        Binding="{Binding Custo, Converter={StaticResource MoedaConverter}}"
                                        Width="100"/>
                    <DataGridTextColumn Header="Preço Venda"
                                        Binding="{Binding PrecoVenda, Converter={StaticResource MoedaConverter}}"
                                        Width="120"/>
                    <DataGridTemplateColumn Header="Status" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Center" CornerRadius="4" Padding="8,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#D4EDDA"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SemEstoque}" Value="True">
                                                    <Setter Property="Background" Value="#F8D7DA"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EstoqueBaixo}" Value="True">
                                                    <Setter Property="Background" Value="#FFF3CD"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="OK"/>
                                                <Setter Property="Foreground" Value="#155724"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SemEstoque}" Value="True">
                                                        <Setter Property="Text" Value="Sem Estoque"/>
                                                        <Setter Property="Foreground" Value="#721C24"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EstoqueBaixo}" Value="True">
                                                        <Setter Property="Text" Value="Baixo"/>
                                                        <Setter Property="Foreground" Value="#856404"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="#80FFFFFF" Visibility="{Binding Carregando, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Carregando..." FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PretoPrimarioBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,8" Margin="0,10,0,0">
                <Grid>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource CinzaTextoBrush}"
                               Text="{Binding InfoPaginacao}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BotaoSecundario}" Content="◀ Anterior"
                                Command="{Binding PaginaAnteriorCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource BotaoSecundario}" Content="Próxima ▶"
                                Command="{Binding PaginaProximaCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
