<Window x:Class="ImperialColors.UI.Views.NotaFiscalFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nota Fiscal" Width="980" Height="880" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/ImperialColors;component/Resources/AppTheme.xaml"/>
    </Window.Resources>

    <Grid Background="{StaticResource CinzaClaroBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="{StaticResource PretoPrimarioBrush}" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtTitulo" Text="Cadastrar NF" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <Border Grid.Column="1" x:Name="BadgeStatus" Background="{StaticResource AmareloPrimarioBrush}"
                        CornerRadius="4" Padding="10,4">
                    <TextBlock x:Name="TxtStatus" Text="RASCUNHO" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource PretoPrimarioBrush}"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewerComMargem}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <!-- ============ BLOCO: NOTA FISCAL ============ -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Nota Fiscal" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Tipo de Saída"/>
                                <TextBox x:Name="TxtTipoSaida" Style="{StaticResource TextBoxModerno}" Text="Emissão própria"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Série"/>
                                <TextBox x:Name="TxtSerie" Style="{StaticResource TextBoxModerno}" MaxLength="3"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Número"/>
                                <TextBox x:Name="TxtNumero" Style="{StaticResource TextBoxModerno}" MaxLength="9"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Data de Emissão"/>
                                <TextBox x:Name="TxtDataEmissao" Style="{StaticResource TextBoxModerno}" IsReadOnly="True"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="0.6*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Natureza da Operação"/>
                                <ComboBox x:Name="CmbNatureza" Style="{StaticResource ComboBoxModerno}"
                                          SelectionChanged="CmbNatureza_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Finalidade"/>
                                <ComboBox x:Name="CmbFinalidade" Style="{StaticResource ComboBoxModerno}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="CRT"/>
                                <TextBox x:Name="TxtCrt" Style="{StaticResource TextBoxModerno}" IsReadOnly="True"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Indicador de Presença"/>
                                <ComboBox x:Name="CmbIndicadorPresenca" Style="{StaticResource ComboBoxModerno}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                <CheckBox x:Name="ChkConsumidorFinal" Content="Operação para consumidor final"
                                          Style="{StaticResource CheckBoxModerno}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Data de Saída (opcional)"/>
                                <TextBox x:Name="TxtDataSaida" Style="{StaticResource TextBoxModerno}"
                                         ToolTip="dd/MM/aaaa — em branco usa a data de emissão"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Intermediador — CNPJ (opcional)"/>
                                <TextBox x:Name="TxtIntermediadorCnpj" Style="{StaticResource TextBoxModerno}" MaxLength="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Intermediador — Identificador (opcional)"/>
                                <TextBox x:Name="TxtIntermediadorIdentificador" Style="{StaticResource TextBoxModerno}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ BLOCO: DESTINATÁRIO ============ -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Destinatário" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtAvisoDestinatario" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"
                                   Foreground="{StaticResource CinzaTextoBrush}"
                                   Text="Obrigatório em NF-e. Na NFC-e pode ficar em branco (venda sem identificação do comprador)."/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Buscar cliente cadastrado (por nome)"/>
                                <TextBox x:Name="TxtBuscaCliente" Style="{StaticResource TextBoxModerno}"
                                         KeyDown="TxtBuscaCliente_KeyDown"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Buscar" Style="{StaticResource BotaoSecundario}"
                                    VerticalAlignment="Bottom" Height="36" Padding="14,0" Click="BtnBuscarCliente_Click"/>
                        </Grid>
                        <ListBox x:Name="LstResultadosCliente" Visibility="Collapsed" MaxHeight="140" Margin="0,0,0,10"
                                 MouseDoubleClick="LstResultadosCliente_MouseDoubleClick"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="RbPessoaFisica" GroupName="TipoPessoaDest" Content="Pessoa Física" Margin="0,0,20,0"/>
                            <RadioButton x:Name="RbPessoaJuridica" GroupName="TipoPessoaDest" Content="Pessoa Jurídica"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Nome / Razão Social"/>
                                <TextBox x:Name="TxtDestinatarioNome" Style="{StaticResource TextBoxModerno}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="CPF / CNPJ"/>
                                <TextBox x:Name="TxtDestinatarioDocumento" Style="{StaticResource TextBoxModerno}" MaxLength="18"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Contribuinte (IE)"
                                           ToolTip="Diz à SEFAZ se o destinatário tem cadastro de ICMS ativo. Só quando marcado 'Contribuinte de ICMS' a Inscrição Estadual ao lado é enviada na nota — nos outros casos ela é ignorada, mesmo preenchida."/>
                                <ComboBox x:Name="CmbIndicadorIe" Style="{StaticResource ComboBoxModerno}"
                                          SelectionChanged="CmbIndicadorIe_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Inscrição Estadual"
                                           ToolTip="Só é enviada à SEFAZ se 'Contribuinte (IE)' ao lado estiver como 'Contribuinte de ICMS'. Preencher aqui muda o indicador automaticamente."/>
                                <TextBox x:Name="TxtDestinatarioIe" Style="{StaticResource TextBoxModerno}"
                                         TextChanged="TxtDestinatarioIe_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Suframa (opcional)"/>
                                <TextBox x:Name="TxtSuframa" Style="{StaticResource TextBoxModerno}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="CEP"/>
                                <TextBox x:Name="TxtDestinatarioCep" Style="{StaticResource TextBoxModerno}" MaxLength="9"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Buscar" Style="{StaticResource BotaoSecundario}"
                                    VerticalAlignment="Bottom" Height="36" Padding="10,0" Click="BtnBuscarCepDestinatario_Click"/>
                            <StackPanel Grid.Column="3">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Logradouro"/>
                                <TextBox x:Name="TxtDestinatarioLogradouro" Style="{StaticResource TextBoxModerno}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="5">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Número"/>
                                <TextBox x:Name="TxtDestinatarioNumero" Style="{StaticResource TextBoxModerno}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="0.5*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="0.7*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Complemento"/>
                                <TextBox x:Name="TxtDestinatarioComplemento" Style="{StaticResource TextBoxModerno}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Bairro"/>
                                <TextBox x:Name="TxtDestinatarioBairro" Style="{StaticResource TextBoxModerno}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Cidade"/>
                                <TextBox x:Name="TxtDestinatarioCidade" Style="{StaticResource TextBoxModerno}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="UF"/>
                                <TextBox x:Name="TxtDestinatarioUf" Style="{StaticResource TextBoxModerno}" MaxLength="2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="8">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Cód. IBGE"/>
                                <TextBox x:Name="TxtDestinatarioCodigoIbge" Style="{StaticResource TextBoxModerno}" IsReadOnly="True"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Fone"/>
                                <TextBox x:Name="TxtDestinatarioTelefone" Style="{StaticResource TextBoxModerno}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="E-mail"/>
                                <TextBox x:Name="TxtDestinatarioEmail" Style="{StaticResource TextBoxModerno}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Vendedor"/>
                                <TextBox x:Name="TxtVendedor" Style="{StaticResource TextBoxModerno}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Lista de Preço"/>
                                <TextBox x:Name="TxtListaPreco" Style="{StaticResource TextBoxModerno}"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="ChkEntregaDiferente" Content="O endereço de entrega é diferente do endereço de cobrança"
                                  Style="{StaticResource CheckBoxModerno}" Checked="ChkEntregaDiferente_Changed"
                                  Unchecked="ChkEntregaDiferente_Changed"/>

                        <StackPanel x:Name="PainelEntrega" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock Text="Endereço de Entrega" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="CEP"/>
                                    <TextBox x:Name="TxtEntregaCep" Style="{StaticResource TextBoxModerno}" MaxLength="9"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="Logradouro"/>
                                    <TextBox x:Name="TxtEntregaLogradouro" Style="{StaticResource TextBoxModerno}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="Número"/>
                                    <TextBox x:Name="TxtEntregaNumero" Style="{StaticResource TextBoxModerno}"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="0.5*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="Complemento"/>
                                    <TextBox x:Name="TxtEntregaComplemento" Style="{StaticResource TextBoxModerno}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="Bairro"/>
                                    <TextBox x:Name="TxtEntregaBairro" Style="{StaticResource TextBoxModerno}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="Cidade"/>
                                    <TextBox x:Name="TxtEntregaCidade" Style="{StaticResource TextBoxModerno}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Style="{StaticResource LabelCampo}" Text="UF"/>
                                    <TextBox x:Name="TxtEntregaUf" Style="{StaticResource TextBoxModerno}" MaxLength="2"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ ABA: PRODUTOS OU SERVIÇOS ============ -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Produtos ou Serviços" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtBuscaProduto" Style="{StaticResource TextBoxModerno}"
                                     ToolTip="Busque por nome, código interno ou código de barras — do estoque cadastrado"
                                     KeyDown="TxtBuscaProduto_KeyDown"/>
                            <Button Grid.Column="2" Content="Buscar no estoque" Style="{StaticResource BotaoSecundario}"
                                    Padding="14,8" Click="BtnBuscarProduto_Click"/>
                        </Grid>
                        <ListBox x:Name="LstResultadosProduto" Visibility="Collapsed" MaxHeight="160" Margin="0,0,0,10"
                                 MouseDoubleClick="LstResultadosProduto_MouseDoubleClick"/>

                        <DataGrid x:Name="GridItens" AutoGenerateColumns="False" CanUserAddRows="False"
                                  Style="{StaticResource DataGridModerno}" MinHeight="160" MaxHeight="320"
                                  CellEditEnding="GridItens_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding NItem}" Width="35" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Código" Binding="{Binding CodigoProduto}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="NCM" Binding="{Binding Ncm}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="CFOP" Binding="{Binding Cfop}" Width="60" IsReadOnly="True"/>
                                <DataGridTextColumn Header="CST/CSOSN" Binding="{Binding CodigoIcms}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Alíq. ICMS" Binding="{Binding AliquotaIcms, StringFormat=N2}" Width="75" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Un." Binding="{Binding Unidade}" Width="45" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Qtd." Binding="{Binding Quantidade, StringFormat=N4}" Width="80" IsReadOnly="False"/>
                                <DataGridTextColumn Header="Vlr. Unit." Binding="{Binding ValorUnitario, StringFormat=N2}" Width="90" IsReadOnly="False"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding ValorTotal, StringFormat=N2}" Width="90" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Atualizar" Style="{StaticResource BotaoSecundario}" FontSize="11"
                                                        Padding="6,2" Margin="0,0,4,0" Click="BtnAtualizarItem_Click"
                                                        ToolTip="Traz de novo os dados fiscais (NCM, CFOP, CST/CSOSN, GTIN etc.) do cadastro do produto no estoque, sem precisar remover e readicionar este item."/>
                                                <Button Content="Remover" Style="{StaticResource BotaoPerigo}" FontSize="11"
                                                        Padding="6,2" Click="BtnRemoverItem_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="TxtAvisosItens" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{StaticResource VermelhoErroBrush}"/>
                    </StackPanel>
                </Border>

                <!-- ============ BLOCO: CÁLCULO DO IMPOSTO ============ -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Cálculo do Imposto" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                            <CheckBox x:Name="ChkCalculoAutomatico" Content="Cálculo automático"
                                      Style="{StaticResource CheckBoxModerno}" IsChecked="True"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="ChkCalculoAutomatico_Changed" Unchecked="ChkCalculoAutomatico_Changed"
                                      ToolTip="Desmarque para editar os valores. Ao marcar novamente, os totais são recalculados a partir dos itens."/>
                        </Grid>
                        <TextBlock Text="Para alterar os valores, desmarque Cálculo automático. Confira os totais manuais com os itens antes de emitir."
                                   TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"
                                   Foreground="{StaticResource CinzaTextoBrush}"/>

                        <!-- "Total Serviços" (vServ) e "Valor ISSQN" (vIssqn) foram removidos daqui:
                             este módulo emite NF-e/NFC-e (modelos 55/65), que não têm grupo ISSQN no
                             payload. Enquanto existiram, qualquer valor digitado neles entrava no
                             total local mas NÃO no vNF transmitido — a nota saía com total menor que
                             a soma dos pagamentos e a SEFAZ rejeitava. Ver NotaFiscal.VServ. -->
                        <UniformGrid Columns="4" Rows="5" TextBox.TextChanged="CampoCalculo_TextChanged">
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Total Produtos"/>
                                <TextBox x:Name="TxtVProd" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Valor do Frete"/>
                                <TextBox x:Name="TxtVFrete" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Valor do Seguro"/>
                                <TextBox x:Name="TxtVSeg" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Base ICMS"/>
                                <TextBox x:Name="TxtVBcIcms" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Valor ICMS"/>
                                <TextBox x:Name="TxtVIcms" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Base ICMS ST"/>
                                <TextBox x:Name="TxtVBcIcmsSt" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Valor ICMS ST"/>
                                <TextBox x:Name="TxtVIcmsSt" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Valor IPI"/>
                                <TextBox x:Name="TxtVIpi" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="IPI Devolvido"/>
                                <TextBox x:Name="TxtVIpiDevolvido" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Despesas"/>
                                <TextBox x:Name="TxtVOutro" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Desconto"/>
                                <TextBox x:Name="TxtVDesc" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Valor Funrural"/>
                                <TextBox x:Name="TxtVFunrural" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Nº Itens"/>
                                <TextBox x:Name="TxtNumeroItens" Style="{StaticResource TextBoxModerno}" IsReadOnly="True"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Valor Aprox. Impostos"/>
                                <TextBox x:Name="TxtVAproxImp" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Total do FCP"/>
                                <TextBox x:Name="TxtVFcp" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Total FCP ST"/>
                                <TextBox x:Name="TxtVFcpSt" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="FCP ST Ret. Anteriormente"/>
                                <TextBox x:Name="TxtVFcpStRet" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="TOTAL DA NOTA" FontWeight="Bold"/>
                                <TextBox x:Name="TxtVNf" Style="{StaticResource TextBoxNumerico}" FontWeight="Bold" IsReadOnly="True"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ============ BLOCO: TRANSPORTADOR / VOLUMES ============ -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Transportador / Volumes" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Forma de Envio"/>
                                <ComboBox x:Name="CmbFormaEnvio" Style="{StaticResource ComboBoxModerno}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Peso Bruto (kg)"/>
                                <TextBox x:Name="TxtPesoBruto" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Peso Líquido (kg)"/>
                                <TextBox x:Name="TxtPesoLiquido" Style="{StaticResource TextBoxNumerico}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                <CheckBox x:Name="ChkEnviarExpedicao" Content="Enviar para expedição" Style="{StaticResource CheckBoxModerno}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ BLOCO: PAGAMENTO ============ -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Pagamento" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Forma de Recebimento"/>
                                <TextBox x:Name="TxtFormaRecebimento" Style="{StaticResource TextBoxModerno}" Text="Múltiplas"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Categoria"/>
                                <TextBox x:Name="TxtCategoriaFinanceira" Style="{StaticResource TextBoxModerno}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Condição de Pagamento"/>
                                <TextBox x:Name="TxtCondicaoPagamento" Style="{StaticResource TextBoxModerno}"
                                         ToolTip="Texto livre — ex.: '30 60', '3x' ou '15+2x'"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" x:Name="CmbNovaFormaPagamento" Style="{StaticResource ComboBoxModerno}"/>
                            <TextBox Grid.Column="2" x:Name="TxtNovoPagamentoValor" Style="{StaticResource TextBoxNumerico}"
                                     ToolTip="Valor"/>
                            <TextBox Grid.Column="4" x:Name="TxtNovoPagamentoParcelas" Style="{StaticResource TextBoxModerno}"
                                     Text="1" ToolTip="Parcelas"/>
                            <Button Grid.Column="6" Content="+ Adicionar Pagamento" Style="{StaticResource BotaoSecundario}"
                                    Padding="10,8" Click="BtnAdicionarPagamento_Click"/>
                        </Grid>

                        <DataGrid x:Name="GridPagamentos" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" Style="{StaticResource DataGridModerno}" MaxHeight="150">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Forma" Binding="{Binding FormaPagamentoDescricao}" Width="*"/>
                                <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat=N2}" Width="120"/>
                                <DataGridTextColumn Header="Parcelas" Binding="{Binding QuantidadeParcelas}" Width="80"/>
                                <DataGridTemplateColumn Header="" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remover" Style="{StaticResource BotaoPerigo}" FontSize="11"
                                                    Padding="6,2" Click="BtnRemoverPagamento_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ============ BLOCO: DADOS ADICIONAIS ============ -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Dados Adicionais" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Depósito"/>
                                <TextBox x:Name="TxtDeposito" Style="{StaticResource TextBoxModerno}" Text="Padrão"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelCampo}" Text="Marcadores (separados por vírgula)"/>
                                <TextBox x:Name="TxtMarcadores" Style="{StaticResource TextBoxModerno}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource LabelCampo}" Text="Observações"/>
                        <TextBox x:Name="TxtObservacoes" Style="{StaticResource TextBoxMultilinha}" Height="50" Margin="0,0,0,10"/>

                        <TextBlock Style="{StaticResource LabelCampo}" Text="Observações do Sistema (geradas pela Natureza de Operação selecionada)"/>
                        <TextBox x:Name="TxtObservacoesSistema" Style="{StaticResource TextBoxMultilinha}" Height="40"
                                 IsReadOnly="True" Margin="0,0,0,10"/>

                        <TextBlock Style="{StaticResource LabelCampo}" Text="Informações ao Fisco"/>
                        <TextBox x:Name="TxtInformacoesFisco" Style="{StaticResource TextBoxMultilinha}" Height="50"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Rodapé -->
        <Border Grid.Row="2" Background="White" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtMensagemStatus" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="500" FontSize="12"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Fechar" Style="{StaticResource BotaoSecundario}" Margin="0,0,10,0"
                            Click="BtnFechar_Click"/>
                    <Button x:Name="BtnSalvarRascunho" Content="Salvar" Style="{StaticResource BotaoPrimario}"
                            Click="BtnSalvarRascunho_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
