<UserControl x:Class="ImperialColors.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ImperialColors.UI.Converters"
             xmlns:helpers="clr-namespace:ImperialColors.UI.Helpers"
             xmlns:vm="clr-namespace:ImperialColors.UI.ViewModels"
             xmlns:app="clr-namespace:ImperialColors.Application.DTOs;assembly=ImperialColors.Application">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ImperialColors;component/Resources/AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:MoedaConverter x:Key="MoedaConverter"/>
            <conv:DataConverter x:Key="DataConverter"/>
            <conv:PercentualParaLarguraConverter x:Key="PercentualParaLarguraConverter"/>
            <conv:SinalParaCorConverter x:Key="SinalParaCorConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:EstoqueStatusColorConverter x:Key="EstoqueStatusColorConverter"/>
            <conv:DiasParaVencerConverter x:Key="DiasParaVencerConverter"/>
            <conv:QuantidadeUnidadeConverter x:Key="QuantidadeUnidadeConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Style="{StaticResource ScrollViewerComMargem}"
                  helpers:ScrollViewerMouseWheelHelper.Habilitar="True">
        <Grid Margin="30,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="ImgLogoDashboard" Width="48" Height="48" Margin="0,0,16,0" Stretch="Uniform"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TituloModulo}" Text="Dashboard"/>
                        <TextBlock x:Name="TxtEmpresaDashboard" Foreground="{StaticResource CinzaTextoBrush}"
                                   FontSize="13" Margin="0,4,0,0"/>
                        <TextBlock Foreground="{StaticResource CinzaTextoBrush}" FontSize="13"
                                   Text="{Binding DataHoje}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Seletor de visão — IsChecked em Mode=OneWay porque o estado de "quem
                         está marcado" é 100% ditado pelo ViewModel (VisaoAtual), evitando dois
                         botões marcados ao mesmo tempo (ToggleButton não tem exclusão mútua
                         nativa fora de RadioButton/GroupName). -->
                    <ToggleButton Content="Financeiro" Style="{StaticResource TogglePagamento}" Margin="0,0,8,0"
                                  IsChecked="{Binding MostrarFinanceiro, Mode=OneWay}"
                                  Command="{Binding TrocarVisaoCommand}" CommandParameter="{x:Static vm:VisaoDashboard.Financeiro}"/>
                    <ToggleButton Content="Estoque" Style="{StaticResource TogglePagamento}" Margin="0,0,8,0"
                                  IsChecked="{Binding MostrarEstoque, Mode=OneWay}"
                                  Command="{Binding TrocarVisaoCommand}" CommandParameter="{x:Static vm:VisaoDashboard.Estoque}"/>
                    <ToggleButton Content="Vendas" Style="{StaticResource TogglePagamento}" Margin="0,0,8,0"
                                  IsChecked="{Binding MostrarVendas, Mode=OneWay}"
                                  Command="{Binding TrocarVisaoCommand}" CommandParameter="{x:Static vm:VisaoDashboard.Vendas}"/>
                    <ToggleButton Content="Comissões" Style="{StaticResource TogglePagamento}" Margin="0,0,20,0"
                                  IsChecked="{Binding MostrarComissoes, Mode=OneWay}"
                                  Command="{Binding TrocarVisaoCommand}" CommandParameter="{x:Static vm:VisaoDashboard.Comissoes}"/>

                    <Button Style="{StaticResource BotaoSecundario}"
                            Command="{Binding CarregarCommand}" Content="⟳  Atualizar"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">

                <!-- ===== Visão Financeiro ===== -->
                <StackPanel Visibility="{Binding MostrarFinanceiro, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- KPIs — giro de estoque e faturamento -->
                    <UniformGrid Columns="4" HorizontalAlignment="Stretch">

                        <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠" FontSize="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="ESTOQUE CRÍTICO" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource CinzaTextoBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Margin="0,10,0,0" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource LaranjaAvisoBrush}"
                                           Text="{Binding ProdutosEstoqueCritico}"/>
                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource CinzaTextoBrush}"
                                           Text="Menos de 5 unidades"/>
                                <Border Margin="0,10,0,0" Height="3" CornerRadius="2"
                                        Background="{StaticResource LaranjaAvisoBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⛔" FontSize="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="ESTOQUE ZERADO" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource CinzaTextoBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Margin="0,10,0,0" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource VermelhoErroBrush}"
                                           Text="{Binding ProdutosSemEstoque}"/>
                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource CinzaTextoBrush}"
                                           Text="Itens sem saldo"/>
                                <Border Margin="0,10,0,0" Height="3" CornerRadius="2"
                                        Background="{StaticResource VermelhoErroBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💰" FontSize="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="FATURAMENTO DO DIA" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource CinzaTextoBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Margin="0,10,0,0" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource PretoPrimarioBrush}"
                                           Text="{Binding TotalVendasHoje, Converter={StaticResource MoedaConverter}}"/>
                                <Border Margin="0,14,0,0" Height="3" CornerRadius="2"
                                        Background="{StaticResource AmareloPrimarioBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20,18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📈" FontSize="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="FATURAMENTO DO MÊS" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource CinzaTextoBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Margin="0,10,0,0" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource PretoPrimarioBrush}"
                                           Text="{Binding TotalVendasMes, Converter={StaticResource MoedaConverter}}"/>
                                <Border Margin="0,14,0,0" Height="3" CornerRadius="2"
                                        Background="{StaticResource VerdeSucessoBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Controle Financeiro: lucro, custo e margem -->
                    <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Text="Controle Financeiro" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                            <UniformGrid Columns="4" HorizontalAlignment="Stretch">
                                <Border Margin="0,0,12,0" Padding="16,14" Background="{StaticResource CinzaClaroBrush}" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="LUCRO DO DIA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CinzaTextoBrush}"/>
                                        <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="Bold"
                                                   Foreground="{Binding LucroHoje, Converter={StaticResource SinalParaCorConverter}}"
                                                   Text="{Binding LucroHoje, Converter={StaticResource MoedaConverter}}"/>
                                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource CinzaTextoBrush}">
                                            <Run Text="Margem "/><Run Text="{Binding MargemLucroHoje, StringFormat={}{0}%}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,12,0" Padding="16,14" Background="{StaticResource CinzaClaroBrush}" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="LUCRO DO MÊS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CinzaTextoBrush}"/>
                                        <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="Bold"
                                                   Foreground="{Binding LucroMes, Converter={StaticResource SinalParaCorConverter}}"
                                                   Text="{Binding LucroMes, Converter={StaticResource MoedaConverter}}"/>
                                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource CinzaTextoBrush}">
                                            <Run Text="Margem "/><Run Text="{Binding MargemLucroMes, StringFormat={}{0}%}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,12,0" Padding="16,14" Background="{StaticResource CinzaClaroBrush}" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="CUSTO DO MÊS (CMV)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CinzaTextoBrush}"/>
                                        <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="Bold"
                                                   Foreground="{StaticResource PretoPrimarioBrush}"
                                                   Text="{Binding CustoMes, Converter={StaticResource MoedaConverter}}"/>
                                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource CinzaTextoBrush}"
                                                   Text="Custo dos produtos vendidos"/>
                                    </StackPanel>
                                </Border>

                                <Border Padding="16,14" Background="{StaticResource CinzaClaroBrush}" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="TICKET MÉDIO DO MÊS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CinzaTextoBrush}"/>
                                        <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="Bold"
                                                   Foreground="{StaticResource PretoPrimarioBrush}"
                                                   Text="{Binding TicketMedioMes, Converter={StaticResource MoedaConverter}}"/>
                                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource CinzaTextoBrush}">
                                            <Run Text="{Binding QuantidadeVendasMes}"/><Run Text=" vendas no mês"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Margin="0,16,0,0" Padding="12,10" Background="#FFF8E1" CornerRadius="6"
                                    Visibility="{Binding ExisteItemSemCusto, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource PretoPrimarioBrush}">
                                    <Run Text="⚠ "/><Run Text="{Binding ItensSemCustoCadastradoMes}" FontWeight="Bold"/>
                                    <Run Text=" item(ns) vendido(s) este mês são de produtos sem &quot;Custo&quot; cadastrado — eles entram no faturamento, mas não no cálculo de lucro/margem acima. Cadastre o custo em Estoque → Produtos para um número mais preciso."/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Lucro dos últimos 7 dias -->
                    <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Text="Lucro dos Últimos 7 Dias" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                            <ItemsControl ItemsSource="{Binding LucroUltimos7Dias}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DiaSemanaAbreviado}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{StaticResource CinzaTextoBrush}"/>
                                                <TextBlock Text="{Binding DataFormatada}" FontSize="10"
                                                           Foreground="{StaticResource CinzaTextoBrush}"/>
                                            </StackPanel>

                                            <Border Grid.Column="1" Height="18" CornerRadius="3" HorizontalAlignment="Left"
                                                    VerticalAlignment="Center" Background="{StaticResource CinzaClaroBrush}" Width="200">
                                                <Border CornerRadius="3" HorizontalAlignment="Left"
                                                        Background="{StaticResource AmareloPrimarioBrush}"
                                                        Width="{Binding PercentualBarra, Converter={StaticResource PercentualParaLarguraConverter}, ConverterParameter=200}"/>
                                            </Border>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="12" Foreground="{StaticResource CinzaTextoBrush}">
                                                    <Run Text="Faturamento "/><Run Text="{Binding Faturamento, Converter={StaticResource MoedaConverter}}" FontWeight="SemiBold" Foreground="{StaticResource PretoPrimarioBrush}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="12" Margin="18,0,0,0" Foreground="{StaticResource CinzaTextoBrush}">
                                                    <Run Text="Lucro "/><Run Text="{Binding Lucro, Converter={StaticResource MoedaConverter}}" FontWeight="SemiBold"
                                                                             Foreground="{Binding Lucro, Converter={StaticResource SinalParaCorConverter}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Visão Estoque ===== -->
                <StackPanel Visibility="{Binding MostrarEstoque, Converter={StaticResource BoolToVisibilityConverter}}">

                    <Border Style="{StaticResource Card}" Padding="22,18">
                        <StackPanel>
                            <TextBlock Text="Produtos Próximos da Validade" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Vencimento em até 15 dias, ou já vencidos — inclui só itens com saldo em estoque."
                                       FontSize="11" Foreground="{StaticResource CinzaTextoBrush}" Margin="0,0,0,16"/>

                            <ItemsControl ItemsSource="{Binding ProximosDaValidade}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,10" Margin="0,0,0,6" Background="{StaticResource CinzaClaroBrush}" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="160"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding NomeExibicao}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DataValidade, Converter={StaticResource DataConverter}}"
                                                           FontSize="12" Foreground="{StaticResource CinzaTextoBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding DataValidade, Converter={StaticResource DiasParaVencerConverter}}"
                                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Text="Produtos com Pouca Quantidade" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                            <ItemsControl ItemsSource="{Binding PoucaQuantidade}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,10" Margin="0,0,0,6" Background="{StaticResource CinzaClaroBrush}" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="140"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding NomeExibicao}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{Binding EstoqueBaixo, Converter={StaticResource EstoqueStatusColorConverter}}">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource QuantidadeUnidadeConverter}">
                                                            <Binding Path="QuantidadeEstoque"/>
                                                            <Binding Path="Unidade"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" FontSize="12" Foreground="{StaticResource CinzaTextoBrush}" VerticalAlignment="Center">
                                                    <Run Text="Mínimo: "/><Run Text="{Binding EstoqueMinimo}"/>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Text="Produtos Mais Vendidos do Mês" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                            <ItemsControl ItemsSource="{Binding MaisVendidos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,10" Margin="0,0,0,6" Background="{StaticResource CinzaClaroBrush}" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Posicao}" FontSize="12" FontWeight="Bold"
                                                           Foreground="{StaticResource AmareloPrimarioBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding NomeProduto}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding QuantidadeTotal, StringFormat=N0}" FontSize="12"
                                                           Foreground="{StaticResource CinzaTextoBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding FaturamentoGerado, Converter={StaticResource MoedaConverter}}"
                                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Visão Vendas ===== -->
                <StackPanel Visibility="{Binding MostrarVendas, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- Seletor de período dos dois blocos abaixo. IsChecked em Mode=OneWay pelo
                         mesmo motivo do seletor de visão: o ViewModel decide quem está marcado. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                        <TextBlock Text="Período:" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{StaticResource CinzaTextoBrush}"/>
                        <ToggleButton x:Name="BtnPeriodoMes" Content="Mês" Style="{StaticResource TogglePagamento}" Margin="0,0,8,0"
                                      IsChecked="{Binding PeriodoEhMes, Mode=OneWay}"
                                      Command="{Binding TrocarPeriodoProdutosCommand}" CommandParameter="{x:Static app:PeriodoDashboard.Mes}"/>
                        <ToggleButton x:Name="BtnPeriodoTotal" Content="Total" Style="{StaticResource TogglePagamento}"
                                      IsChecked="{Binding PeriodoEhTotal, Mode=OneWay}"
                                      Command="{Binding TrocarPeriodoProdutosCommand}" CommandParameter="{x:Static app:PeriodoDashboard.Total}"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22,18">
                            <StackPanel>
                                <TextBlock Text="{Binding TituloItensPorCategoria}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Balcão e vendas externas, em unidades" FontSize="11" Margin="0,0,0,14"
                                           Foreground="{StaticResource CinzaTextoBrush}"/>

                                <TextBlock Text="{Binding MensagemSemItensVendidos}" FontSize="12"
                                           Foreground="{StaticResource CinzaTextoBrush}"
                                           Visibility="{Binding SemItensVendidosNoMes, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <ItemsControl ItemsSource="{Binding ItensPorCategoria}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Categoria}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding QuantidadeItens, StringFormat={}{0:0.###}}"
                                                           FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                                <!-- Largura fixa da trilha (como nas barras do lucro): a barra proporcional
                                                     usa a mesma medida, então a maior categoria sempre fecha a trilha. -->
                                                <Border Grid.Row="1" Grid.ColumnSpan="2" Height="6" Width="300" CornerRadius="3" Margin="0,4,0,0"
                                                        HorizontalAlignment="Left" Background="{StaticResource CinzaClaroBrush}">
                                                    <Border CornerRadius="3" HorizontalAlignment="Left"
                                                            Background="{StaticResource AmareloPrimarioBrush}"
                                                            Width="{Binding PercentualBarra, Converter={StaticResource PercentualParaLarguraConverter}, ConverterParameter=300}"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18">
                            <StackPanel>
                                <TextBlock Text="{Binding TituloMaisVendidos}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Unidades vendidas e em quantas vendas apareceu" FontSize="11" Margin="0,0,0,14"
                                           Foreground="{StaticResource CinzaTextoBrush}"/>

                                <TextBlock Text="{Binding MensagemSemItensVendidos}" FontSize="12"
                                           Foreground="{StaticResource CinzaTextoBrush}"
                                           Visibility="{Binding SemItensVendidosNoMes, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <ItemsControl ItemsSource="{Binding ProdutosMaisVendidosMes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12,10" Margin="0,0,0,6" Background="{StaticResource CinzaClaroBrush}" CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Posicao}" FontSize="12" FontWeight="Bold"
                                                               Foreground="{StaticResource AmareloPrimarioBrush}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding NomeProduto}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding CodigoInterno}" FontSize="10"
                                                                   Foreground="{StaticResource CinzaTextoBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                                                        <TextBlock FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right">
                                                            <Run Text="{Binding QuantidadeVendida, StringFormat={}{0:0.###}, Mode=OneWay}"/><Run Text=" un."/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="10" HorizontalAlignment="Right"
                                                                   Foreground="{StaticResource CinzaTextoBrush}">
                                                            <Run Text="{Binding QuantidadeVendas, Mode=OneWay}"/><Run Text=" venda(s)"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" Padding="22,18">
                        <StackPanel>
                            <TextBlock Text="Maiores Vendas do Mês" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                            <ItemsControl ItemsSource="{Binding MaioresVendas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,10" Margin="0,0,0,6" Background="{StaticResource CinzaClaroBrush}" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Data, Converter={StaticResource DataConverter}}"
                                                           FontSize="12" Foreground="{StaticResource CinzaTextoBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ClienteNome}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FormaPagamentoDescricao}" FontSize="12"
                                                           Foreground="{StaticResource CinzaTextoBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Total, Converter={StaticResource MoedaConverter}}"
                                                           FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Visão Comissões (venda externa) ===== -->
                <StackPanel Visibility="{Binding MostrarComissoes, Converter={StaticResource BoolToVisibilityConverter}}">

                    <UniformGrid Columns="3" Rows="1" Margin="0,0,0,20">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="COMISSÕES A PAGAR" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource CinzaTextoBrush}"/>
                                <TextBlock Text="{Binding ComissoesAPagar, Converter={StaticResource MoedaConverter}}"
                                           FontSize="26" FontWeight="Bold" Margin="0,8,0,0"
                                           Foreground="{StaticResource VermelhoErroBrush}"/>
                                <TextBlock FontSize="11" Margin="0,2,0,0" Foreground="{StaticResource CinzaTextoBrush}">
                                    <Run Text="{Binding QuantidadeComissoesAPagar, Mode=OneWay}"/><Run Text=" venda(s) aguardando acerto"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="JÁ PAGO" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource CinzaTextoBrush}"/>
                                <TextBlock Text="{Binding ComissoesPagas, Converter={StaticResource MoedaConverter}}"
                                           FontSize="26" FontWeight="Bold" Margin="0,8,0,0"
                                           Foreground="{StaticResource VerdeSucessoBrush}"/>
                                <TextBlock Text="total já repassado aos vendedores" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{StaticResource CinzaTextoBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="COMISSÕES DO MÊS" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource CinzaTextoBrush}"/>
                                <TextBlock Text="{Binding ComissoesDoMes, Converter={StaticResource MoedaConverter}}"
                                           FontSize="26" FontWeight="Bold" Margin="0,8,0,0"
                                           Foreground="{StaticResource PretoPrimarioBrush}"/>
                                <TextBlock Text="pagas ou não — o custo de vender na rua no mês"
                                           FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource CinzaTextoBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Comissões a pagar" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="O acerto é marcado em Vendas externas → Comissões."
                                       FontSize="11" Margin="0,0,0,16"
                                       Foreground="{StaticResource CinzaTextoBrush}"/>

                            <TextBlock Text="Nenhuma comissão a pagar. Tudo acertado."
                                       FontSize="13" Margin="0,8,0,8"
                                       Foreground="{StaticResource CinzaTextoBrush}"
                                       Visibility="{Binding SemComissoesPendentes, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <ItemsControl ItemsSource="{Binding ComissoesPendentes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,10" Margin="0,0,0,6" Background="{StaticResource CinzaClaroBrush}" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DataVenda, Converter={StaticResource DataConverter}}"
                                                           FontSize="12" Foreground="{StaticResource CinzaTextoBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding NumeroVendaExterna}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{StaticResource CinzaTextoBrush}">
                                                    <Run Text="venda de "/><Run Text="{Binding TotalVenda, Converter={StaticResource MoedaConverter}, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="3" Text="{Binding Comissao, Converter={StaticResource MoedaConverter}}"
                                                           FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource VermelhoErroBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
